// Prisma Schema für Lernassistent
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Gamification & Streak
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  points        Int       @default(0)
  lastStudyDate DateTime?

  // Abo-Modell
  plan              String    @default("free") // "free" | "pro"
  planExpiresAt     DateTime?                  // null = free, Datum fuer Pro
  storageUsedBytes  BigInt    @default(0)      // Speicherverbrauch in Bytes
  apiTokensUsedThisMonth Int  @default(0)      // Claude Token-Verbrauch diesen Monat
  apiUsageResetAt   DateTime  @default(now())  // Monatlicher Reset-Zeitpunkt

  decks         Deck[]
  sessions      Session[]
  accounts      Account[]
  quizResults   QuizResult[]
  chatMessages  ChatMessage[]
  userBadges    UserBadge[]
  lernfortschritte Lernfortschritt[]
  simulationRuns   SimulationRun[]
  spielstaende     Spielstand[]
  architekturLaeufe ArchitekturLauf[]
  ipmaAttempts       IpmaAttempt[]
  ipmaQuestionStates IpmaQuestionState[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#58CC02")
  icon        String   @default("📚")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // OpenDeck sharing
  shareStatus          String    @default("none") // "none" | "pending" | "approved" | "rejected"
  shareRequestedAt     DateTime?
  shareReviewedAt      DateTime?
  shareRejectionReason String?
  isFeatured           Boolean   @default(false)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  quizResults QuizResult[]

  @@index([shareStatus])
}

model Card {
  id        String   @id @default(cuid())
  front     String
  back      String
  hint      String?
  deckId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FSRS Felder
  due           DateTime @default(now())
  stability     Float    @default(0)
  difficulty    Float    @default(0)
  elapsedDays   Int      @default(0)
  scheduledDays Int      @default(0)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  state         Int      @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  lastReview    DateTime?

  deck    Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  cardId    String
  rating    Int      // 1=Again, 2=Hard, 3=Good, 4=Easy
  duration  Int      @default(0) // Antwortzeit in Sekunden
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id            String   @id @default(cuid())
  userId        String
  deckId        String
  quizType      String   // "multiple_choice" | "true_false" | "free_text"
  totalQuestions Int
  correctAnswers Int
  score         Int      // Verdiente Punkte
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  condition   String   @unique // z.B. "first_card", "streak_7"
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// Fortschritt im Lernpfad: eine Zeile pro Konto, Fach und Thema (Station).
// Fach und Thema verweisen auf content/lernseiten/<fach>/fach.json (kein Fremdschluessel).
model Lernfortschritt {
  id          String   @id @default(cuid())
  userId      String
  fach        String   // z.B. "mstw"
  thema       String   // Slug der Station, z.B. "08-laplace-bedingte-wahrscheinlichkeit"
  status      String   // "begonnen" | "erledigt" (erledigt wird nie zurueckgestuft)
  quizRichtig Int?
  quizGesamt  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fach, thema])
  @@index([userId, fach])
}

// Lauf im Leitstand (Projektsimulator). Massgebend sind seed + actions;
// summary und score berechnet der Server beim Nachspielen (lib/leitstand.ts).
model SimulationRun {
  id              String    @id @default(cuid())
  userId          String
  scenarioId      String    // "wolkenried" | "einfuehrung"
  scenarioVersion String
  engineVersion   Int
  seed            Int       // 1 … 2'147'483'646, vom Server erzeugt
  seedReused      Boolean   @default(false) // Wiederholung mit bekanntem Startwert
  status          String    // "aktiv" | "abgeschlossen" | "abgebrochen" | "veraltet"
  actions         Json      // Action[]
  actionCount     Int       @default(0)
  tick            Int       @default(0)
  summary         Json?     // { tag, phase, spi, cpi, qi, motivation, si, rmi }
  score           Int?
  stars           Int?
  scoreDetail     Json?     // RunResult
  pointsAwarded   Int       @default(0) // Punkte ins Konto beim Abschluss (Bestwert-Verbesserung ÷ 10)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finishedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scenarioId, status])
  @@index([userId, scenarioId, score])
  // Zusätzlich Teil-Index «SimulationRun_aktiv_eindeutig» (userId, scenarioId) WHERE status = 'aktiv',
  // nur in prisma/migrations/20261101100000_simulation_run_aktiv_eindeutig (Prisma kennt keine Teil-Indizes).
}

// Lauf im Architektur-Leitstand (docs/architektur-leitstand.md). Massgebend sind seed + aktionen
// (+ modell bei Missionen zum Modellieren); summary und score berechnet der Server beim Nachspielen
// (lib/architektur-leitstand.ts mit dem Simulator-Kern lib/archsim).
model ArchitekturLauf {
  id             String    @id @default(cuid())
  userId         String
  missionId      String    // z. B. "m1-velokurier" (lib/archsim/scenarios)
  missionVersion Int
  engineVersion  Int       // ARCHSIM_VERSION beim Start
  seed           Int       // 1 … 2'147'483'646, vom Server erzeugt
  seedReused     Boolean   @default(false) // Wiederholung mit bekanntem Startwert: kein Bestwert, keine Punkte
  status         String    // "aktiv" | "abgeschlossen" | "abgebrochen" | "veraltet"
  aktionen       Json      // Aktion[] (lib/archsim)
  aktionCount    Int       @default(0)
  modell         Json?     // ArchModell des Spielers, nur Missionen zum Modellieren; fest ab der ersten Aktion
  tick           Int       @default(0)
  summary        Json?     // { minute, phase, verfuegbarkeit, p95, kosten, rueckstau }
  score          Int?
  stars          Int?
  scoreDetail    Json?     // { score, kennzahlen, nachbesprechung, validierung }
  pointsAwarded  Int       @default(0) // Punkte ins Konto beim Abschluss (Bestwert-Verbesserung ÷ 10)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, missionId, status])
  @@index([userId, missionId, score])
  @@index([userId, createdAt])
  // Zusätzlich Teil-Index «ArchitekturLauf_aktiv_eindeutig» (userId, missionId) WHERE status = 'aktiv',
  // nur in prisma/migrations/20261104100000_add_architektur_lauf (Prisma kennt keine Teil-Indizes).
}

// Bestwert eines Modellierspiel-Levels im Lernpfad (docs/architektur-modell.md, Abschnitt 8).
// Bestwert = mehr Sterne, bei Gleichstand mehr XP; schlechtere Ergebnisse ändern nichts.
model Spielstand {
  id        String   @id @default(cuid())
  userId    String
  fach      String   // z.B. "avsw"
  spiel     String   // spielId, z.B. "avsw-02-kommunikation"
  level     String   // levelId, z.B. "l1"
  sterne    Int      // 0–3
  xp        Int      // 0–500
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Deckt auch die Abfrage je Konto und Fach ab (GET), daher kein zusätzlicher Index
  @@unique([userId, fach, spiel, level])
}

// Versuch im IPMA-Prüfungssimulator (Spezifikation docs/ipma-pruefungssimulator-spezifikation.md 6.4).
// Die Auswahl der Fragen (inkl. Reihenfolge der Optionen) liegt nur hier und wird nie an den Client gegeben.
// Ergebnis berechnet der Server (lib/ipma/scoring.ts, lib/ipma/server.ts).
model IpmaAttempt {
  id            String    @id @default(cuid())
  userId        String
  mode          String    // "exam" | "short" | "training" | "gaps"
  variant       String    @default("strict") // "strict" (Echtbedingungen) | "pausable"
  status        String    // "active" | "submitted" | "finished" | "aborted"
  seed          Int       // 1 … 2'147'483'646, vom Server
  poolVersion   String
  configVersion Int
  config        Json      // ConfigSnapshot (6.3)
  competences   String[]  // Training: gewählte Kompetenzen; Lücken: die drei schwächsten
  itemCount     Int
  startedAt     DateTime  @default(now())
  deadlineAt    DateTime? // nur strict bei exam/short
  pausedAt      DateTime? // nur pausable, gesetzt während Pause
  resumedAt     DateTime? // nur pausable: letzter Start (Beginn oder Weiter), Grundlage für activeSeconds
  activeSeconds Int       @default(0)
  submittedAt   DateTime?
  finishedAt    DateTime?
  pointsQ       Int?      // Viertelpunkte
  maxPointsQ    Int?
  shownCount    Int?
  passed        Boolean?
  result        Json?     // AttemptResult
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items IpmaAttemptItem[]

  @@index([userId, mode, status])
  @@index([userId, mode, finishedAt])
  // Zusätzlich Teil-Index «IpmaAttempt_aktiv_eindeutig» (userId, mode) WHERE status = 'active',
  // nur in prisma/migrations/20261102100000_ipma_aktiv_eindeutig (Prisma kennt keine Teil-Indizes).
}

model IpmaAttemptItem {
  id              String    @id @default(cuid())
  attemptId       String
  position        Int       // 1 … itemCount
  questionId      String    // "3.04-mc-01"
  questionVersion Int
  type            String    // "mc" | "offen"
  competence      String    // "3.04"
  optionOrder     Int[]     // MC: Anzeigeposition → Originalindex; nie an den Client
  choice          Int?      // MC: Originalindex der Wahl
  text            String?   // offen: höchstens 3'000 Zeichen
  flagged         Boolean   @default(false)
  answeredAt      DateTime?
  locked          Boolean   @default(false) // Training/Lücken: nach «Prüfen»; Prüfung: nach Abgabe
  selfScores      Int[]     // Rasterpunkte je Kriterium
  selfAssessedAt  DateTime?
  aiStatus        String    @default("none") // "none" | "pending" | "done" | "failed"
  aiScores        Int[]
  aiFeedback      Json?     // { kriterien: [{ nummer, punkte, begruendung }], gesamtkommentar, verdacht }
  aiTokens        Int       @default(0)
  aiAssessedAt    DateTime?
  scoreSource     String?   // "mc" | "self" | "ai"
  rasterPoints    Int?      // offen: massgebend 0 … 4
  correct         Boolean?
  pointsQ         Int?

  attempt IpmaAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, position])
  @@index([attemptId, competence])
  @@index([questionId])
}

// Leitner-Fach und Kontakt je Konto und Frage (Lücken schliessen, Auswahl ohne Wiederholung)
model IpmaQuestionState {
  id           String    @id @default(cuid())
  userId       String
  questionId   String
  box          Int       @default(0) // 0 = gesehen, nie bewertet; 1 … 5
  dueAt        DateTime?
  seenCount    Int       @default(0)
  correctCount Int       @default(0)
  lastCorrect  Boolean?
  lastSeenAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  ipHash    String
  emailSent Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
